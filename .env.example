# Copy to .env (or set these in Portainer's stack environment variables).
# Never commit a file containing your real API key.

# Required
LIDARR_URL=http://LIDARR_LXC_IP:8686
LIDARR_API_KEY=PUT_YOUR_LIDARR_API_KEY_HERE
TZ=America/Chicago

# Daily search cap: a random number in this range is chosen each local day.
# MIN_SEARCHES_PER_DAY defaults to 70% of the max if left empty.
MIN_SEARCHES_PER_DAY=105
MAX_SEARCHES_PER_DAY=150

# Daily grab cap (Deezer grabs only). Set MAX_DOWNLOADS_PER_DAY=0 to disable.
MIN_DOWNLOADS_PER_DAY=10
MAX_DOWNLOADS_PER_DAY=30

# Search pacing
BATCH_SIZE=5
MIN_CHUNK_DELAY_SECONDS=900
MAX_CHUNK_DELAY_SECONDS=2700
IDLE_RETRY_SECONDS=300
# Should be longer than the number of days one full pass takes (8760h = 1 year),
# so each album is searched once per pass.
ALBUM_COOLDOWN_HOURS=8760
COMMAND_TIMEOUT_SECONDS=1800

# Album selection: newest_artist (most recently added artists first) or random
SEARCH_ORDER=newest_artist
MISSING_PAGE_SIZE=500
# Reloading a large missing list can take many minutes, so refresh it rarely.
MISSING_REFRESH_MINUTES=1440

# Indexer management. While a scheduled search runs, Automatic Search is turned
# off on every other indexer and on for Deezer, then restored afterwards.
DEEZER_INDEXER_NAME=Deezer
MANAGE_DEEZER_AUTOMATIC_SEARCH=true
MANAGE_OTHER_INDEXERS=true
# Comma-separated indexer names that must never be touched
OTHER_INDEXERS_EXCLUDE=

# Failure safety check
SAFETY_CHECK_ENABLED=true
# Optional: exact name of the Lidarr download client that handles Deezer grabs
DEEZER_DOWNLOAD_CLIENT_NAME=
FAIL_LOOKBACK_HOURS=24
FAIL_MIN_FAILURES=3
FAIL_RATIO=0.5
FAIL_PAUSE_HOURS=12

LOG_LEVEL=INFO
