# Required
LIDARR_URL=http://LIDARR_LXC_IP:8686
LIDARR_API_KEY=PUT_YOUR_LIDARR_API_KEY_HERE

# Search scheduling
BATCH_SIZE=5
MAX_SEARCHES_PER_DAY=100
MIN_CHUNK_DELAY_SECONDS=900
MAX_CHUNK_DELAY_SECONDS=2700
IDLE_RETRY_SECONDS=300
ALBUM_COOLDOWN_HOURS=72
MISSING_PAGE_SIZE=500
COMMAND_TIMEOUT_SECONDS=600
LOG_LEVEL=INFO
